-- FloorPin local store (offline-first single source of truth).
-- Timestamps are epoch millis (INTEGER). Ids are client/server UUIDs (TEXT).

CREATE TABLE project (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  description TEXT,
  createdAt INTEGER NOT NULL DEFAULT 0,
  updatedAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE floorPlan (
  id TEXT NOT NULL PRIMARY KEY,
  projectId TEXT NOT NULL,
  name TEXT NOT NULL,
  sub TEXT,
  imageKey TEXT,
  imageUrl TEXT,
  createdAt INTEGER NOT NULL DEFAULT 0,
  updatedAt INTEGER NOT NULL DEFAULT 0,
  width REAL,
  height REAL
);

CREATE TABLE location (
  id TEXT NOT NULL PRIMARY KEY,
  floorPlanId TEXT NOT NULL,
  name TEXT NOT NULL,
  x REAL NOT NULL,
  y REAL NOT NULL,
  updatedAt INTEGER NOT NULL DEFAULT 0,
  createdAt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE issue (
  id TEXT NOT NULL PRIMARY KEY,
  locationId TEXT NOT NULL,
  title TEXT NOT NULL,
  description TEXT,
  status TEXT NOT NULL DEFAULT 'open',
  priority TEXT,
  type TEXT,
  x REAL,
  y REAL,
  createdAt INTEGER NOT NULL DEFAULT 0,
  updatedAt INTEGER NOT NULL DEFAULT 0,
  resolvedAt INTEGER,
  category TEXT,
  item TEXT,
  assignedTo TEXT
);

-- A photo exists as a row from the moment it is taken. `pending = 1` means the bytes are still in
-- photoBlob and have not reached R2 yet; imageKey stays NULL until they do.
CREATE TABLE photo (
  id TEXT NOT NULL PRIMARY KEY,
  issueId TEXT NOT NULL,
  imageKey TEXT,
  imageUrl TEXT,
  createdAt INTEGER NOT NULL DEFAULT 0,
  caption TEXT,
  pending INTEGER NOT NULL DEFAULT 0,
  fileName TEXT,
  attempts INTEGER NOT NULL DEFAULT 0,
  failedAt INTEGER
);

-- Bytes for photos awaiting upload. Kept in a side table so that no list query ever drags a blob
-- through a cursor — ReportScreen observes every photo on a floor plan.
CREATE TABLE photoBlob (
  photoId TEXT NOT NULL PRIMARY KEY,
  bytes BLOB NOT NULL
);

CREATE TABLE activity (
  id TEXT NOT NULL PRIMARY KEY,
  entityType TEXT,
  entityId TEXT,
  action TEXT,
  actor TEXT,
  summary TEXT,
  createdAt INTEGER NOT NULL DEFAULT 0
);

-- Pending offline operations, replayed via POST /api/sync.
CREATE TABLE outbox (
  opId TEXT NOT NULL PRIMARY KEY,
  entity TEXT NOT NULL,        -- projects | locations | issues
  op TEXT NOT NULL,            -- create | update | delete
  entityId TEXT NOT NULL,
  payload TEXT NOT NULL,       -- JSON body for the op
  updatedAt INTEGER NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0,
  failedAt INTEGER,            -- set once the server has rejected it MAX_ATTEMPTS times
  lastError TEXT               -- why, so the user isn't told "pending" forever with no cause
);

-- ── project ──
projectsAll:
SELECT * FROM project ORDER BY createdAt DESC;
projectById:
SELECT * FROM project WHERE id = ?;
upsertProject:
INSERT OR REPLACE INTO project(id, name, description, createdAt, updatedAt) VALUES (?, ?, ?, ?, ?);
deleteProject:
DELETE FROM project WHERE id = ?;

-- ── floorPlan ──
floorPlansByProject:
SELECT * FROM floorPlan WHERE projectId = ? ORDER BY createdAt DESC;
floorPlanById:
SELECT * FROM floorPlan WHERE id = ?;
upsertFloorPlan:
INSERT OR REPLACE INTO floorPlan(id, projectId, name, sub, imageKey, imageUrl, createdAt, updatedAt, width, height) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
deleteFloorPlan:
DELETE FROM floorPlan WHERE id = ?;

-- ── location ──
locationsByFloorPlan:
SELECT * FROM location WHERE floorPlanId = ? ORDER BY updatedAt ASC;
locationById:
SELECT * FROM location WHERE id = ?;
upsertLocation:
INSERT OR REPLACE INTO location(id, floorPlanId, name, x, y, updatedAt, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?);
renameLocation:
UPDATE location SET name = ?, updatedAt = ? WHERE id = ?;
moveLocation:
UPDATE location SET x = ?, y = ?, updatedAt = ? WHERE id = ?;
deleteLocation:
DELETE FROM location WHERE id = ?;

-- ── issue ──
issuesByLocation:
SELECT * FROM issue WHERE locationId = ? ORDER BY createdAt DESC;
issuesByFloorPlan:
SELECT issue.* FROM issue JOIN location ON issue.locationId = location.id WHERE location.floorPlanId = ?;
issueById:
SELECT * FROM issue WHERE id = ?;
upsertIssue:
INSERT OR REPLACE INTO issue(id, locationId, title, description, status, priority, type, x, y, createdAt, updatedAt, resolvedAt, category, item, assignedTo) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
updateIssueStatus:
UPDATE issue SET status = ?, resolvedAt = ?, updatedAt = ? WHERE id = ?;
updateIssueDetails:
UPDATE issue SET title = ?, description = ?, priority = ?, type = ?, category = ?, item = ?, updatedAt = ? WHERE id = ?;
moveIssue:
UPDATE issue SET x = ?, y = ?, updatedAt = ? WHERE id = ?;
deleteIssue:
DELETE FROM issue WHERE id = ?;

-- ── photo ──
photosByIssue:
SELECT * FROM photo WHERE issueId = ? ORDER BY createdAt ASC;
photosByFloorPlan:
SELECT photo.* FROM photo
  JOIN issue ON photo.issueId = issue.id
  JOIN location ON issue.locationId = location.id
  WHERE location.floorPlanId = ?;
upsertPhoto:
INSERT OR REPLACE INTO photo(id, issueId, imageKey, imageUrl, createdAt, caption, pending, fileName, attempts, failedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
-- ── pending photo queue ──
-- Oldest first, so a long offline session uploads in the order the inspector shot them.
pendingPhotos:
SELECT * FROM photo WHERE pending = 1 AND failedAt IS NULL ORDER BY createdAt ASC;
pendingPhotoCount:
SELECT count(*) FROM photo WHERE pending = 1 AND failedAt IS NULL;
failedPhotoCount:
SELECT count(*) FROM photo WHERE pending = 1 AND failedAt IS NOT NULL;
retryFailedPhotos:
UPDATE photo SET failedAt = NULL, attempts = 0 WHERE pending = 1 AND failedAt IS NOT NULL;
photoBlobById:
SELECT bytes FROM photoBlob WHERE photoId = ?;
putPhotoBlob:
INSERT OR REPLACE INTO photoBlob(photoId, bytes) VALUES (?, ?);
deletePhotoBlob:
DELETE FROM photoBlob WHERE photoId = ?;
-- Upload succeeded: adopt the server's key and drop the local copy of the bytes.
markPhotoUploaded:
UPDATE photo SET pending = 0, imageKey = ?, attempts = 0, failedAt = NULL WHERE id = ?;
bumpPhotoAttempts:
UPDATE photo SET attempts = attempts + 1 WHERE id = ?;
markPhotoFailed:
UPDATE photo SET failedAt = ? WHERE id = ?;
deletePhoto:
DELETE FROM photo WHERE id = ?;

-- ── activity ──
activityAll:
SELECT * FROM activity ORDER BY createdAt DESC LIMIT ? OFFSET ?;
upsertActivity:
INSERT OR REPLACE INTO activity(id, entityType, entityId, action, actor, summary, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?);

-- ── outbox ──
enqueue:
INSERT OR REPLACE INTO outbox(opId, entity, op, entityId, payload, updatedAt, attempts, failedAt, lastError)
VALUES (?, ?, ?, ?, ?, ?, ?, NULL, NULL);
-- Only ops that haven't dead-lettered are worth sending. A failed op stays in the table so the
-- user can be told about it; excluding it here is what stops it blocking everything behind it.
outboxPending:
SELECT * FROM outbox WHERE failedAt IS NULL ORDER BY updatedAt ASC;
outboxUpdatesFor:
SELECT * FROM outbox WHERE entity = ? AND entityId = ? AND op = 'update' AND failedAt IS NULL;
outboxCount:
SELECT count(*) FROM outbox WHERE failedAt IS NULL;
outboxFailed:
SELECT * FROM outbox WHERE failedAt IS NOT NULL ORDER BY failedAt DESC;
outboxFailedCount:
SELECT count(*) FROM outbox WHERE failedAt IS NOT NULL;
dequeue:
DELETE FROM outbox WHERE opId = ?;
bumpAttempts:
UPDATE outbox SET attempts = attempts + 1 WHERE opId = ?;
-- Dead-letter: keep the row and the payload so the failure is inspectable and recoverable.
markFailed:
UPDATE outbox SET failedAt = ?, lastError = ? WHERE opId = ?;
-- User-driven "try again" on a dead-lettered op.
retryFailed:
UPDATE outbox SET failedAt = NULL, lastError = NULL, attempts = 0 WHERE opId = ?;
discardFailed:
DELETE FROM outbox WHERE failedAt IS NOT NULL;

-- ── server reconciliation ──
-- A refresh that only upserts can never forget. Anything deleted on another device stayed on this
-- one forever, and opening it produced a 404 against an id the server has never heard of.
deleteProjectsNotIn:
DELETE FROM project WHERE id NOT IN ?;
deleteFloorPlansNotIn:
DELETE FROM floorPlan WHERE projectId = ? AND id NOT IN ?;
-- Cascade by hand: no SQL foreign keys in this schema, so a pruned parent leaves its subtree behind.
deleteOrphanFloorPlans:
DELETE FROM floorPlan WHERE projectId NOT IN (SELECT id FROM project);
deleteOrphanLocations:
DELETE FROM location WHERE floorPlanId NOT IN (SELECT id FROM floorPlan);
deleteOrphanIssues:
DELETE FROM issue WHERE locationId NOT IN (SELECT id FROM location);
deleteOrphanPhotos:
DELETE FROM photo WHERE issueId NOT IN (SELECT id FROM issue);
deleteOrphanPhotoBlobs:
DELETE FROM photoBlob WHERE photoId NOT IN (SELECT id FROM photo);

-- ── maintenance ──
clearAll {
DELETE FROM project;
DELETE FROM floorPlan;
DELETE FROM location;
DELETE FROM issue;
DELETE FROM photo;
DELETE FROM photoBlob;
DELETE FROM activity;
DELETE FROM outbox;
}
